#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { quick-tap-ms = <150>; };

&mt { quick-tap-ms = <150>; };

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;

        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&lt 2 ESC                   &kp Q               &kp W  &kp E     &kp R     &kp T        &kp Y    &kp U          &kp I       &kp O    &kp P                    &kp BSPC
&kp TAB                     &lt 3 A             &kp S  &kp D     &kp F     &kp G        &kp H    &kp J          &kp K       &kp L    &lt 1 SEMICOLON          &kp SQT
&mt LSHFT LEFT_PARENTHESIS  &mt LEFT_CONTROL Z  &kp X  &kp C     &kp V     &kp B        &kp N    &kp M          &kp COMMA   &kp DOT  &mt RIGHT_CONTROL SLASH  &mt RIGHT_SHIFT RIGHT_PARENTHESIS
                                                       &kp LGUI  &kp LALT  &kp SPACE    &kp RET  &kp BACKSPACE  &kp DELETE
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |Studio|
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB             &kp N1  &kp N2  &kp N3    &kp N4  &kp N5       &kp PG_UP        &kp HOME           &kp UP_ARROW  &kp END    &trans  &kp BSPC
&kp LA(F4)          &kp N6  &kp N7  &kp N8    &kp N9  &kp N0       &kp PAGE_DOWN    &kp LEFT           &kp DOWN      &kp RIGHT  &trans  &studio_unlock
&kp LA(LEFT_BRACE)  &trans  &trans  &trans    &trans  &trans       &kp MINUS        &kp UNDERSCORE     &trans        &trans     &trans  &kp RIGHT_BRACE
                                    &kp LGUI  &trans  &kp SPACE    &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &kp KP_N0     &kp KP_N7      &kp KP_N8   &kp KP_N9  &kp RPAR  &kp BSPC
&kp LCTRL  &trans        &trans        &trans        &trans        &trans        &kp KP_PLUS   &kp KP_N4      &kp KP_N5   &kp KP_N6  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans        &trans        &trans        &trans        &trans        &kp KP_MINUS  &kp KP_N1      &kp KP_N2   &kp KP_N3  &kp PIPE  &kp TILDE
                                       &kp LGUI      &trans        &kp SPACE     &kp RET       &kp BACKSPACE  &kp DELETE
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &kp K_BACK      &mmv MOVE_UP    &kp K_FORWARD    &msc SCRL_UP      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans            &trans  &trans  &trans  &trans  &trans  &trans
                                &mkp MCLK       &mkp RCLK        &mkp LCLK         &trans  &trans  &trans
            >;

            label = "Mouse";
        };
    };
};
